# 这是可公开的空值模板。不要在本文件填真实令牌。
# 真实文件：~/.local/share/01yang-company-website/ops/运维私有配置.env
# 文件权限600，目录700；仅scripts/ops.mjs读取，网站构建不加载此文件。

# 官网专属五年只读令牌：流水线、运行实例、运行任务读取
YUNXIAO_TOKEN=
YUNXIAO_TOKEN_NAME=
YUNXIAO_TOKEN_EXPIRES_AT=

# 中心站组织及官网专属资源ID（不得使用25th流水线/分组/变量组ID）
YUNXIAO_ORGANIZATION_ID=
YUNXIAO_PIPELINE_ID=
YUNXIAO_PIPELINE_GROUP_ID=
YUNXIAO_VARIABLE_GROUP_ID=
YUNXIAO_FLOW_DOMAIN=https://openapi-rdc.aliyuncs.com

# 可选：官网流水线的私有触发URL；按凭据保管，不提交、不输出、不用它做只读检查
YUNXIAO_WEBHOOK_URL=

# 运维索引，不会自动改变SSH或服务器状态
OPS_SSH_HOST=
OPS_SSH_USER=01yang-deploy
# 人工运维私钥路径索引，约定文件名id_ed25519_01yang_company；不填写私钥正文
OPS_SSH_KEY_FILE=
# CI专用私钥路径索引，约定文件名id_ed25519_01yang_company_ci；只允许publish
# 云效专属变量组中的加密变量COMPANY_DEPLOY_SSH_KEY保存此密钥值，不保存PAT
OPS_CI_SSH_KEY_FILE=

# 仅影响健康检查预期，不会开启网站；正式放行开关由服务器管理员控制
OPS_EXPECT_PUBLIC=false
