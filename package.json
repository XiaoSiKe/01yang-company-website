{
  "name": "01yang-company-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.16.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && node scripts/prepare-static.mjs",
    "start": "vite preview --config deploy/preview.config.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit --incremental false",
    "verify:static": "node scripts/verify-static.mjs",
    "ci:verify": "npm run typecheck && npm run lint -- --no-cache && npm run build && npm run verify:static",
    "release:package": "bash deploy/package-release.sh",
    "ops:status": "node scripts/ops.mjs status",
    "ops:runs": "node scripts/ops.mjs runs",
    "ops:check": "node scripts/ops.mjs check"
  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "ogl": "^1.0.11",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-icons": "^5.7.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
